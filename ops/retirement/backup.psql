-- Optional operator-only archival role. Review and rehearse before installation.
-- No application migration, inherited membership, table writes or app DB access.
\set ON_ERROR_STOP on
DO $$ BEGIN
 IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='aqua_retirement_backup')
 THEN RAISE EXCEPTION 'retirement_backup_role_already_exists'; END IF;
 IF NOT EXISTS (SELECT 1 FROM pg_database WHERE datname='aqua_retirement')
 THEN RAISE EXCEPTION 'retirement_installation_required'; END IF;
END $$;
CREATE ROLE aqua_retirement_backup LOGIN NOINHERIT NOSUPERUSER NOCREATEDB
 NOCREATEROLE NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 1;
SELECT format('ALTER ROLE aqua_retirement_backup PASSWORD %L', :'backup_password') \gexec
GRANT CONNECT ON DATABASE aqua_retirement TO aqua_retirement_backup;
REVOKE ALL ON DATABASE aqua_app FROM aqua_retirement_backup;
ALTER ROLE aqua_retirement_backup IN DATABASE aqua_retirement SET search_path=pg_catalog,retirement;
ALTER ROLE aqua_retirement_backup IN DATABASE aqua_retirement SET default_transaction_read_only=on;
ALTER ROLE aqua_retirement_backup IN DATABASE aqua_retirement SET statement_timeout='30s';
ALTER ROLE aqua_retirement_backup IN DATABASE aqua_retirement SET lock_timeout='1s';
ALTER ROLE aqua_retirement_backup IN DATABASE aqua_retirement SET idle_in_transaction_session_timeout='120s';
\connect aqua_retirement
SET ROLE aqua_retirement_owner;
GRANT USAGE ON SCHEMA retirement TO aqua_retirement_backup;
-- Explicit list: future tables require a new reviewed archival protocol.
GRANT SELECT ON retirement.control,retirement.owners,retirement.intents,
 retirement.pages,retirement.fingerprints,retirement.journal TO aqua_retirement_backup;
RESET ROLE;
-- Retain the original database CONNECTION LIMIT 4. An offline recovery/gate
-- session plus one dump session fit; no per-role pool exceeds one connection.
