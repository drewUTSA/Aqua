# Root context serves the locked runtime and production backend builds.
# Allow only runtime Python, versioned SQL and the reviewed dependency lock.
**
!backend/Dockerfile
!backend/main.py
!backend/auth/*.py
!backend/nl2sql/*.py
!backend/nl2sql/retrieval/*.py
!backend/storage/*.py
!backend/workspace/*.py
!backend/analysis/*.py
!backend/preferences/*.py
!backend/account/*.py
!backend/privacy/*.py
!backend/migrations/*.sql
!tools/checks/Dockerfile
!tools/checks/requirements-runtime.lock

!backend/auth/password_blocklist_*.txt
!backend/auth/password_blocklist_provenance.json
